PORT=4000
JWT_SECRET=change-me
DB_FILE=./data.db
ALLOW_ORIGIN=*,http://localhost:5173
APP_BASE_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=60
# PASSWORD_RESET_CLEANUP_INTERVAL_MS=3600000
# --- AI Provider ---
# Use a local Ollama/LocalAI server (recommended):
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=local-dev
# To use cloud OpenAI instead, set OPENAI_API_KEY and clear AI_BASE_URL:
# OPENAI_API_KEY=sk-...
# AI_BASE_URL=

# --- Model selection per feature ---
# General / telemetry default
AI_MODEL=llama3:8b
# Article generation (prose quality - use a general-purpose model)
OPENAI_ARTICLE_MODEL=llama3:8b
# Admin chat + insights (reasoning - use a reasoning model)
OPENAI_INSIGHTS_MODEL=deepseek-r1:7b
AI_CHAT_MODEL=deepseek-r1:7b
# Public landing page chatbot
OPENAI_CHATBOT_MODEL=llama3:8b
# Telemetry anomaly detection (JSON output + reasoning)
TELEMETRY_AI_MODEL=deepseek-r1:7b
# Receipt/image audit (vision-capable model required)
OPENAI_AUDIT_MODEL=llava:13b
UNSPLASH_ACCESS_KEY=your-unsplash-key
PROTRACK_BASE_URL=https://api.protrack365.com
PROTRACK_ACCOUNT=
PROTRACK_PASSWORD=
PROTRACK_TRACK_PATH=/api/track
PROTRACK_TRACK_MODE=query
PROTRACK_ACCESS_TOKEN_PARAM=access_token
# Trucks are discovered from the Protrack account automatically: the server reads
# /api/device/list, derives the plate from each device name ("KDX 931G: 0300002327981"),
# registers any truck it does not already know, and stores the IMEI on trucks.protrack_imei.
# Nothing below is needed for a newly fitted tracker — leave both blank in normal operation.
PROTRACK_DEVICE_LIST_PATH=/api/device/list
# How often to look for newly fitted devices (default 30 minutes). Set 0 to disable discovery.
PROTRACK_DEVICE_SYNC_INTERVAL_MS=1800000
# Optional manual overrides, applied on top of discovery. Use only to correct a device whose
# name does not match its plate; these win over whatever the account reports.
# PROTRACK_TRACK_IMEIS=355139085250451,355139085340187
# PROTRACK_TRUCK_IMEI_MAP={"KDS477P":"355139085250451","KDS577P":"355139085340187"}
# Legacy/static token fallback (optional):
# PROTRACK_API_TOKEN=your-static-token
# PROTRACK_TRACK_URL=https://api.protrack365.com/api/track
# PROTRACK_API_URL=https://legacy-protrack-endpoint/api/v1
# PROTRACK_AUTH_URL=
# PROTRACK_AUTH_METHOD=POST
# PROTRACK_AUTH_FORMAT=json
# PROTRACK_AUTH_HEADERS={"X-Tenant":"your-tenant-id"}
PROTRACK_TENANT_ID=
TELEMETRY_HIDE_PLATES=
TELEMETRY_HIDE_TRUCK_IDS=
LOW_STOCK_THRESHOLD=50
TELEMETRY_IDLE_THRESHOLD_MIN=120
TELEMETRY_SPEED_ALERT_KPH=65
TELEMETRY_SPEED_ALERT_COOLDOWN_MIN=10
TELEMETRY_AI_ANALYSIS_INTERVAL_MS=300000
TELEMETRY_AI_LOOKBACK_MINUTES=240
TELEMETRY_AI_MIN_POINTS=6
TELEMETRY_AI_MAX_POINTS=60
TELEMETRY_AI_MIN_ANOMALY_CONFIDENCE=0.55
TELEMETRY_AI_MODEL=gpt-4o-mini
ARTICLE_GENERATION_HOUR=5
ARTICLE_GENERATION_MINUTE=20
DISABLE_AUTO_ARTICLES=0
# TELEGRAM_BOT_TOKEN=1234567890:bot-token-from-botfather
GEOCODER_ENDPOINT=https://nominatim.openstreetmap.org/search
GEOCODER_REVERSE_ENDPOINT=https://nominatim.openstreetmap.org/reverse
GEOCODER_EMAIL=support@example.com
GEOCODER_USER_AGENT=arise-shine-logistics/1.0 (support@example.com)

# Cartrack Fleet API
CARTRACK_FLEET_API_BASE_URL=https://fleetapi-ke.cartrack.com/rest
CARTRACK_FLEET_API_USERNAME=your-cartrack-username
CARTRACK_FLEET_API_PASSWORD=your-cartrack-api-password
# Optional overrides:
# CARTRACK_FLEET_API_API_KEY=
# CARTRACK_FLEET_API_TOKEN_URL=
# CARTRACK_FLEET_API_TOKEN_FIELD=access_token
# CARTRACK_FLEET_API_TOKEN_EXPIRES_FIELD=expires_in
# CARTRACK_FLEET_API_TOKEN_TTL_SECONDS=3600
# CARTRACK_FLEET_API_TIMEOUT_MS=15000
# CARTRACK_DEFAULT_CAPACITY_T=20

# SMTP email delivery
# SMTP_URL=smtp://user:pass@mailtrap.io
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=0
SMTP_IGNORE_TLS=0
SMTP_FROM=no-reply@arise.local

# Notification dispatcher tuning
NOTIFICATION_DISPATCH_INTERVAL_MS=30000
NOTIFICATION_DISPATCH_BATCH=10
NOTIFICATION_MAX_ATTEMPTS=5

# Core role account overrides
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_PHONE=

OPS_EMAIL=
OPS_PASSWORD=
OPS_NAME=
OPS_PHONE=

FUEL_EMAIL=
FUEL_PASSWORD=
FUEL_NAME=
FUEL_PHONE=

DRIVER_EMAIL=
DRIVER_PASSWORD=
DRIVER_NAME=
DRIVER_PHONE=
DRIVER_DRIVER_ID=D1
DRIVER_DRIVER_NAME=
DRIVER_DRIVER_PHONE=
DRIVER_DRIVER_EMAIL=
